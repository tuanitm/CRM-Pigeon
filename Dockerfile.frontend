FROM node:20-alpine AS builder

WORKDIR /app

# Build Customer Portal
COPY customer-portal ./customer-portal
WORKDIR /app/customer-portal
RUN npm ci || npm install
RUN npm run build

# Build Admin Dashboard
WORKDIR /app
COPY admin-dashboard ./admin-dashboard
WORKDIR /app/admin-dashboard
RUN npm ci || npm install
RUN npm run build

# Build Zalo MiniApp
WORKDIR /app
COPY zalo-mini-app ./zalo-mini-app
WORKDIR /app/zalo-mini-app
RUN npm ci || npm install
RUN npm run build

# Production server stage
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/customer-portal/dist /usr/share/nginx/html/portal
COPY --from=builder /app/admin-dashboard/dist /usr/share/nginx/html/admin
COPY --from=builder /app/zalo-mini-app/dist /usr/share/nginx/html/zalo

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
