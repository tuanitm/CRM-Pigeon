  referred_id                                        String        @db.Uuid
  status                                             String        @default("pending") @db.VarChar(20)
  referrer_points                                    Int           @default(0)
  referred_points                                    Int           @default(0)
  converted_at                                       DateTime?     @db.Timestamptz(6)
  created_at                                         DateTime      @default(now()) @db.Timestamptz(6)
  referral_code                                      referral_code @relation(fields: [referral_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_referral_conversion_referred_idTocustomer Customer      @relation("referral_conversion_referred_idTocustomer", fields: [referred_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_referral_conversion_referrer_idTocustomer Customer      @relation("referral_conversion_referrer_idTocustomer", fields: [referrer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([referral_code_id, referred_id])
}

model replenishment_schedule {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id      String    @db.Uuid
  product_id       String    @db.Uuid
  cycle_days       Int
  cycle_source     String    @db.VarChar(30)
  last_purchase_at DateTime? @db.Timestamptz(6)
  next_reminder_at DateTime? @db.Timestamptz(6)
  reminder_count   Int       @default(0)
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  customer         Customer  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product          Product   @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customer_id, product_id])
  @@index([next_reminder_at], map: "idx_replenish_next", where: raw("(is_active = true)"))
}

model rfm_snapshot {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id        String   @db.Uuid
  period             String   @db.VarChar(10)
  recency_score      Int
  frequency_score    Int
  monetary_score     Int
  rfm_segment        String   @db.VarChar(50)
  is_discount_hunter Boolean  @default(false)
  calculated_at      DateTime @default(now()) @db.Timestamptz(6)
  customer           Customer @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customer_id, period])
  @@index([period], map: "idx_rfm_snapshot_period")
}

model segment_membership {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  segment_id  String    @db.Uuid
  customer_id String    @db.Uuid
  entered_at  DateTime  @default(now()) @db.Timestamptz(6)
  exited_at   DateTime? @db.Timestamptz(6)
  customer    Customer  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  segment     Segment   @relation(fields: [segment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([segment_id, customer_id])
  @@index([customer_id], map: "idx_segment_membership_customer")
  @@index([segment_id], map: "idx_segment_membership_segment")
}

model serial_batch {
  id              String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  batch_code      String           @unique @db.VarChar(50)
  product_id      String           @db.Uuid
  quantity        Int
  manufactured_at DateTime?        @db.Date
  expires_at      DateTime?        @db.Date
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  product_serial  product_serial[]
  product         Product          @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model serial_scan {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  serial_id      String         @db.Uuid
  customer_id    String?        @db.Uuid
  scan_result    String         @db.VarChar(20)
  ip_address     String?        @db.VarChar(45)
  user_agent     String?
  scanned_at     DateTime       @default(now()) @db.Timestamptz(6)
  customer       Customer?      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_serial product_serial @relation(fields: [serial_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model session {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id  String?   @db.Uuid
  anonymous_id String?   @db.VarChar(255)
  started_at   DateTime  @default(now()) @db.Timestamptz(6)
  ended_at     DateTime? @db.Timestamptz(6)
  page_views   Int       @default(0)
  utm_source   String?   @db.VarChar(100)
  utm_medium   String?   @db.VarChar(100)
  utm_campaign String?   @db.VarChar(100)
  device_type  String?   @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  customer     Customer? @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model subscription {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id           String                  @db.Uuid
  status                String                  @default("active") @db.VarChar(20)
  frequency_days        Int
  next_delivery_date    DateTime?               @db.Date
  payment_method_token  String?                 @db.VarChar(255)
  payment_retry_count   Int                     @default(0)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime                @default(now()) @db.Timestamptz(6)
  customer              Customer                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscription_delivery subscription_delivery[]
  subscription_item     subscription_item[]
}

model subscription_delivery {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subscription_id String       @db.Uuid
  order_id        String?      @db.Uuid
  scheduled_date  DateTime     @db.Date
  status          String       @default("scheduled") @db.VarChar(20)
  delivered_at    DateTime?    @db.Timestamptz(6)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  order           Order?       @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscription    subscription @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model subscription_item {
  id              String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subscription_id String       @db.Uuid
  product_id      String       @db.Uuid
  quantity        Int          @default(1)
  unit_price      Decimal      @db.Decimal(12, 2)
  created_at      DateTime     @default(now()) @db.Timestamptz(6)
  product         Product      @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscription    subscription @relation(fields: [subscription_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model warranty_registration {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customer_id    String          @db.Uuid
  product_id     String          @db.Uuid
  serial_id      String?         @db.Uuid
  purchase_date  DateTime?       @db.Date
  warranty_start DateTime        @db.Date
  warranty_end   DateTime        @db.Date
  status         String          @default("active") @db.VarChar(20)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
