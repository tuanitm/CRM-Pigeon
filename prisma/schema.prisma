generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id                                                            String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerCode                                                  String?                  @unique @map("customer_code") @db.VarChar(20)
  phone                                                         String?                  @unique @db.VarChar(20)
  email                                                         String?                  @db.VarChar(255)
  fullName                                                      String?                  @map("full_name") @db.VarChar(255)
  gender                                                        String?                  @db.VarChar(10)
  dateOfBirth                                                   DateTime?                @map("date_of_birth") @db.Date
  avatarUrl                                                     String?                  @map("avatar_url")
  registrationSource                                            String?                  @map("registration_source") @db.VarChar(50)
  customerType                                                  String?                  @map("customer_type") @db.VarChar(50)
  dmsCode                                                       String?                  @map("dms_code") @db.VarChar(50)
  notes                                                         String?
  dataQualityFlag                                               String?                  @map("data_quality_flag") @db.VarChar(50)
  isMerged                                                      Boolean                  @default(false) @map("is_merged")
  isActive                                                      Boolean                  @default(true) @map("is_active")
  mergedIntoId                                                  String?                  @map("merged_into_id") @db.Uuid
  createdAt                                                     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                     DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  babies                                                        Baby[]
  campaign_control_group                                        campaign_control_group[]
  checklist_progress                                            checklist_progress[]
  consents                                                      Consent[]
  mergedInto                                                    Customer?                @relation("CustomerMerge", fields: [mergedIntoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedFrom                                                    Customer[]               @relation("CustomerMerge")
  addresses                                                     CustomerAddress[]
  identities                                                    CustomerIdentity[]
  customer_metrics_daily                                        customer_metrics_daily[]
  tags                                                          CustomerTag[]
  data_quality_flag_log                                         data_quality_flag_log[]
  dsr_request                                                   dsr_request[]
  event                                                         event[]
  expert_booking                                                expert_booking[]
  frequency_counter                                             frequency_counter[]
  journey_run                                                   journey_run[]
  loyaltyAccount                                                LoyaltyAccount?
  loyalty_transaction                                           LoyaltyTransaction[]
  merge_candidate_merge_candidate_customer_id_aTocustomer       MergeCandidate[]         @relation("merge_candidate_customer_id_aTocustomer")
  merge_candidate_merge_candidate_customer_id_bTocustomer       MergeCandidate[]         @relation("merge_candidate_customer_id_bTocustomer")
  message_log                                                   message_log[]
  milestone_progress                                            milestone_progress[]
  orders                                                        Order[]
  product_exchange                                              ProductExchange[]
  product_serial                                                product_serial[]
  quiz_response                                                 quiz_response[]
  referral_code                                                 referral_code[]
  referral_conversion_referral_conversion_referred_idTocustomer referral_conversion[]    @relation("referral_conversion_referred_idTocustomer")
  referral_conversion_referral_conversion_referrer_idTocustomer referral_conversion[]    @relation("referral_conversion_referrer_idTocustomer")
  replenishment_schedule                                        replenishment_schedule[]
  reviews                                                       Review[]
  reward_redemption                                             RewardRedemption[]
  rfm_snapshot                                                  rfm_snapshot[]
  segment_membership                                            segment_membership[]
  serial_scan                                                   serial_scan[]
  session                                                       session[]
  subscription                                                  subscription[]
  warranty_registration                                         warranty_registration[]
  support_ticket                                                SupportTicket[]
  devices                                                       CustomerDevice[]

  @@index([email], map: "idx_customer_email")
  @@index([phone], map: "idx_customer_phone")
  @@map("customer")
}

model CustomerIdentity {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId    String    @map("customer_id") @db.Uuid
  identityType  String    @map("identity_type") @db.VarChar(30)
  identityValue String    @map("identity_value") @db.VarChar(255)
  priority      Int       @default(0)
  verified      Boolean   @default(false)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([identityType, identityValue])
  @@index([customerId], map: "idx_customer_identity_customer")
  @@index([identityType, identityValue], map: "idx_customer_identity_lookup")
  @@map("customer_identity")
}

model MergeCandidate {
  id                                               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerIdA                                      String    @map("customer_id_a") @db.Uuid
  customerIdB                                      String    @map("customer_id_b") @db.Uuid
  matchReason                                      String?   @map("match_reason") @db.VarChar(100)
  confidenceScore                                  Decimal?  @map("confidence_score") @db.Decimal(5, 2)
  status                                           String    @default("pending") @db.VarChar(20)
  reviewedBy                                       String?   @map("reviewed_by") @db.Uuid
  reviewedAt                                       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt                                        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  customer_merge_candidate_customer_id_aTocustomer Customer  @relation("merge_candidate_customer_id_aTocustomer", fields: [customerIdA], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_merge_candidate_customer_id_bTocustomer Customer  @relation("merge_candidate_customer_id_bTocustomer", fields: [customerIdB], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("merge_candidate")
}

model CustomerAddress {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  label        String?  @db.VarChar(50)
  addressLine1 String?  @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  ward         String?  @db.VarChar(100)
  district     String?  @db.VarChar(100)
  province     String?  @db.VarChar(100)
  country      String   @default("VN") @db.VarChar(10)
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("customer_address")
}

model CustomerTag {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tag        String   @db.VarChar(100)
  source     String?  @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([customerId, tag])
  @@map("customer_tag")
}

model Baby {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId         String               @map("customer_id") @db.Uuid
  name               String?              @db.VarChar(255)
  gender             String?              @db.VarChar(10)
  dateOfBirth        DateTime?            @map("date_of_birth") @db.Date
  dueDate            DateTime?            @map("due_date") @db.Date
  isBorn             Boolean              @default(false) @map("is_born")
  stageCode          String?              @map("stage_code") @db.VarChar(30)
  feedingType        String?              @map("feeding_type") @db.VarChar(20)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer           Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  growthLogs         BabyGrowthLog[]
  stageHistory       BabyStageHistory[]
  checklist_progress checklist_progress[]
  expert_booking     expert_booking[]
  milestone_progress milestone_progress[]

  @@index([customerId], map: "idx_baby_customer")
  @@index([stageCode], map: "idx_baby_stage")
  @@map("baby")
}

model BabyGrowthLog {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  babyId              String   @map("baby_id") @db.Uuid
  recordedAt          DateTime @map("recorded_at") @db.Date
  weightKg            Decimal? @map("weight_kg") @db.Decimal(5, 2)
  heightCm            Decimal? @map("height_cm") @db.Decimal(5, 1)
  headCircumferenceCm Decimal? @map("head_circumference_cm") @db.Decimal(5, 1)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  baby                Baby     @relation(fields: [babyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("baby_growth_log")
}

model BabyStageHistory {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  babyId    String    @map("baby_id") @db.Uuid
  stageCode String    @map("stage_code") @db.VarChar(30)
  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  baby      Baby      @relation(fields: [babyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("baby_stage_history")
}

model ConsentDocumentVersion {
  id            String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentType  String    @map("document_type") @db.VarChar(50)
  version       String    @db.VarChar(20)
  contentUrl    String?   @map("content_url")
  effectiveFrom DateTime  @map("effective_from") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  consents      Consent[]

  @@unique([documentType, version])
  @@map("consent_document_version")
}

model Consent {
  id                String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId        String                  @map("customer_id") @db.Uuid
  channel           String                  @db.VarChar(30)
  status            String                  @default("pending") @db.VarChar(20)
  documentVersionId String?                 @map("document_version_id") @db.Uuid
  grantedAt         DateTime?               @map("granted_at") @db.Timestamptz(6)
  revokedAt         DateTime?               @map("revoked_at") @db.Timestamptz(6)
  ipAddress         String?                 @map("ip_address") @db.VarChar(45)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documentVersion   ConsentDocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customerId, channel], map: "idx_consent_customer_channel")
  @@map("consent")
}

model Product {
  id                                                             String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sku                                                            String                   @unique @db.VarChar(100)
  wooProductId                                                   BigInt?                  @unique @map("woo_product_id")
  name                                                           String                   @db.VarChar(255)
  category                                                       String?                  @db.VarChar(100)
  subcategory                                                    String?                  @db.VarChar(100)
  brand                                                          String?                  @default("PIGEON") @db.VarChar(100)
  stageCodes                                                     Json?                    @default("[]") @map("stage_codes")
  price                                                          Decimal?                 @db.Decimal(12, 2)
  isGwp                                                          Boolean                  @default(false) @map("is_gwp")
  isActive                                                       Boolean                  @default(true) @map("is_active")
  createdAt                                                      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                      DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  orderItems                                                     OrderItem[]
  product_exchange_product_exchange_new_product_idToproduct      ProductExchange[]        @relation("product_exchange_new_product_idToproduct")
  product_exchange_product_exchange_original_product_idToproduct ProductExchange[]        @relation("product_exchange_original_product_idToproduct")
  lifecycleRules                                                 ProductLifecycleRule[]
  product_purchase_cycle                                         product_purchase_cycle[]
  product_serial                                                 product_serial[]
  replenishment_schedule                                         replenishment_schedule[]
  review                                                         Review[]
  serial_batch                                                   serial_batch[]
  subscription_item                                              subscription_item[]
  warranty_registration                                          warranty_registration[]

  @@index([sku], map: "idx_product_sku")
  @@index([stageCodes], map: "idx_product_stage", type: Gin)
  @@map("product")
}

model ProductLifecycleRule {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  stageCode     String?  @map("stage_code") @db.VarChar(30)
  replaceDays   Int      @map("replace_days")
  usageUnit     String?  @map("usage_unit") @db.VarChar(20)
  usageQuantity Decimal? @map("usage_quantity") @db.Decimal(8, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product       Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("product_lifecycle_rule")
}

model Order {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId            String                  @map("customer_id") @db.Uuid
  wooOrderId            BigInt?                 @unique @map("woo_order_id")
  orderNumber           String?                 @map("order_number") @db.VarChar(50)
  status                String                  @db.VarChar(30)
  totalAmount           Decimal                 @default(0) @map("total_amount") @db.Decimal(12, 2)
  discountAmount        Decimal                 @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netAmount             Decimal                 @default(0) @map("net_amount") @db.Decimal(12, 2)
  currency              String                  @default("VND") @db.VarChar(3)
  channel               String?                 @db.VarChar(30)
  isGwp                 Boolean                 @default(false) @map("is_gwp")
  isInternal            Boolean                 @default(false) @map("is_internal")
  shipmentNo            String?                 @map("shipment_no") @db.VarChar(100)
  trackingLink          String?                 @map("tracking_link")
  orderedAt             DateTime                @map("ordered_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer              Customer                @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                 OrderItem[]
  product_exchange      ProductExchange[]
  review                Review[]
  subscription_delivery subscription_delivery[]

  @@index([customerId], map: "idx_order_customer")
  @@index([status], map: "idx_order_status")
  @@map("order")
}

model OrderItem {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  sku        String?  @db.VarChar(100)
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product    Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_item_order")
  @@map("order_item")
}

model ProductExchange {
  id                                                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId                                            String   @map("customer_id") @db.Uuid
  originalOrderId                                       String?  @map("original_order_id") @db.Uuid
  originalProductId                                     String?  @map("original_product_id") @db.Uuid
  newProductId                                          String?  @map("new_product_id") @db.Uuid
  reason                                                String?
  status                                                String   @default("pending") @db.VarChar(20)
  createdAt                                             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer                                              Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_product_exchange_new_product_idToproduct      Product? @relation("product_exchange_new_product_idToproduct", fields: [newProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order                                                 Order?   @relation(fields: [originalOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_product_exchange_original_product_idToproduct Product? @relation("product_exchange_original_product_idToproduct", fields: [originalProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("product_exchange")
}

model Review {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  productId          String   @map("product_id") @db.Uuid
  orderId            String?  @map("order_id") @db.Uuid
  rating             Int
  content            String?
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  status             String   @default("pending") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product            Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("review")
}

model LoyaltyTierConfig {
  id                String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tierCode          String           @unique @map("tier_code") @db.VarChar(30)
  tierName          String           @map("tier_name") @db.VarChar(100)
  tierOrder         Int              @map("tier_order")
  minNetSpend       Decimal          @default(0) @map("min_net_spend") @db.Decimal(12, 2)
  minDistinctMonths Int              @default(0) @map("min_distinct_months")
  pointsMultiplier  Decimal          @default(1.0) @map("points_multiplier") @db.Decimal(4, 2)
  benefits          Json?            @default("{}")
  isDefault         Boolean          @default(false) @map("is_default")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts          LoyaltyAccount[]

  @@map("loyalty_tier_config")
}

model LoyaltyAccount {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  customerId          String               @unique @map("customer_id") @db.Uuid
  tierId              String?              @map("tier_id") @db.Uuid
  pointsBalance       Int                  @default(0) @map("points_balance")
  pointsLifetime      Int                  @default(0) @map("points_lifetime")
  pointsRedeemed      Int                  @default(0) @map("points_redeemed")
  pointsExpired       Int                  @default(0) @map("points_expired")
  netSpend            Decimal              @default(0) @map("net_spend") @db.Decimal(12, 2)
  distinctOrderMonths Int                  @default(0) @map("distinct_order_months")
  tierEvaluatedAt     DateTime?            @map("tier_evaluated_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tier                LoyaltyTierConfig?   @relation(fields: [tierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions        LoyaltyTransaction[]
  reward_redemption   RewardRedemption[]

  @@index([customerId], map: "idx_loyalty_account_customer")
  @@map("loyalty_account")
}

model LoyaltyTransaction {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  loyaltyAccountId String         @map("loyalty_account_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  type             String         @db.VarChar(20)
  source           String         @db.VarChar(50)
  points           Int
  balanceAfter     Int            @map("balance_after")
  referenceType    String?        @map("reference_type") @db.VarChar(50)
  referenceId      String?        @map("reference_id") @db.Uuid
  description      String?
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  idempotencyKey   String?        @unique @map("idempotency_key") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([loyaltyAccountId], map: "idx_loyalty_txn_account")
  @@index([expiresAt], map: "idx_loyalty_txn_expires", where: raw("(expires_at IS NOT NULL)"))
  @@map("loyalty_transaction")
}

model LoyaltyEarnRule {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  source                String    @db.VarChar(50)
  ruleName              String    @map("rule_name") @db.VarChar(255)
  pointsFormula         Json      @map("points_formula")
  conditions            Json?     @default("{}")
  tierMultiplierApplies Boolean   @default(true) @map("tier_multiplier_applies")
  isActive              Boolean   @default(true) @map("is_active")
  validFrom             DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil            DateTime? @map("valid_until") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("loyalty_earn_rule")
}

model RewardCatalog {
  id                String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code              String             @unique @db.VarChar(50)
  name              String             @db.VarChar(255)
  description       String?
  category          String?            @db.VarChar(50)
  pointsCost        Int                @map("points_cost")
  stock             Int?
  imageUrl          String?            @map("image_url")
  isActive          Boolean            @default(true) @map("is_active")
  validFrom         DateTime?          @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime?          @map("valid_until") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  reward_redemption RewardRedemption[]

  @@map("reward_catalog")
}

model RewardRedemption {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  loyaltyAccountId String         @map("loyalty_account_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  rewardId         String         @map("reward_id") @db.Uuid
  pointsSpent      Int            @map("points_spent")
  status           String         @default("pending") @db.VarChar(20)
  shipmentNo       String?        @map("shipment_no") @db.VarChar(100)
  trackingLink     String?        @map("tracking_link")
  fulfilledAt      DateTime?      @map("fulfilled_at") @db.Timestamptz(6)
  idempotencyKey   String?        @unique @map("idempotency_key") @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
